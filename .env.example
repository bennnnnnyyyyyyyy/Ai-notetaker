# ── Application ──────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# ── Database ──────────────────────────────────────────────────────────────────
# Path is relative to project root; data/ is git-ignored
DATABASE_PATH=data/app.db

# ── Data directories (must exist; created automatically on startup) ───────────
RECORDINGS_DIR=data/recordings
TRANSCRIPTS_DIR=data/transcripts
REPORTS_DIR=data/reports
LOGS_DIR=data/logs

# ── Browser ───────────────────────────────────────────────────────────────────
# Chrome User Data root. Keep the profile name separate.
# Example: C:\Users\you\AppData\Local\Google\Chrome\User Data
BROWSER_PROFILE_PATH=C:\Users\ben.arthur\AppData\Local\Google\Chrome\User Data
BROWSER_PROFILE_NAME=Default
BROWSER_EXECUTABLE_PATH=

# ── Audio capture ─────────────────────────────────────────────────────────────
# Name of the DirectShow loopback audio device visible in:
#   ffmpeg -list_devices true -f dshow -i dummy
# Common values:
#   "CABLE Output (VB-Audio Virtual Cable)"
#   "Stereo Mix (Realtek High Definition Audio)"
AUDIO_DEVICE_NAME=CABLE Output (VB-Audio Virtual Cable)

# Absolute path to ffmpeg.exe
FFMPEG_PATH=ffmpeg

# ── Transcription ─────────────────────────────────────────────────────────────
# Model size: tiny | base | small | medium
# Default: base (~150 MB, ~1 GB RAM)
WHISPER_MODEL=base

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Max tokens per transcript chunk sent to the LLM
OLLAMA_CHUNK_TOKENS=3000

# ── Google Sheets export ─────────────────────────────────────────────────────
# Preferred: service-account JSON path. Share the target Sheet with its service-account email.
# Optional fallback: Google Cloud OAuth Desktop app credential and local token.
# Set the target spreadsheet ID from its URL; do not put credentials or tokens in Git.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=Meetings
GOOGLE_SHEETS_SERVICE_ACCOUNT_PATH=
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEETS_TOKEN_PATH=data/google_sheets_token.json

# ── Optional paid adapters (leave blank to use local defaults) ────────────────
# OPENAI_API_KEY=
# RECALL_AI_API_KEY=
